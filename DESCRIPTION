Package: curelearning
Type: Package
Title: Statistical Learning for Cure Models and Long-Term Survival
Version: 0.1.0
Authors@R: c(
    person("Pedro Luiz", "Ramos", role = c("aut", "cre"),
           email = "pedro.ramos@uc.cl",
           comment = c(ORCID = "0000-0002-5387-2457")),
